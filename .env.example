# --- Safety: dry-run is the DEFAULT. Nothing is sent until you set this. ---
DRY_RUN=true

DB_PATH=data/lystos.db
PORT=8080
LOG_LEVEL=info
WORKER_TICK_SECONDS=20

# Meta webhook subscription verification (you choose this string).
WA_VERIFY_TOKEN=change-me

# --- Per-agent secrets (names must match the agent's *.agent.yaml) ---
LYSTOS_EXAMPLE_EMAIL=agent@example.com
LYSTOS_EXAMPLE_PASSWORD=***

WA_EXAMPLE_PHONE_NUMBER_ID=123456789012345
WA_EXAMPLE_ACCESS_TOKEN=EAAG...
