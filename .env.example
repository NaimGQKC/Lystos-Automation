# --- Safety: dry-run is the DEFAULT. Nothing happens until you set this. ---
# DRY_RUN=true   -> render messages into the DB only, contact nothing
# DRY_RUN=false  -> act for real (with email mode: draft, that means
#                   creating drafts in her mailbox — still nothing sent)
DRY_RUN=true

DB_PATH=data/lystos.db
PORT=8080
LOG_LEVEL=info
WORKER_TICK_SECONDS=20

# --- Lystos login (names must match the agent's *.agent.yaml) ---
LYSTOS_EXAMPLE_EMAIL=agent@example.com
LYSTOS_EXAMPLE_PASSWORD=***

# --- Her mailbox: drafts are written here, and sends come from here ---
EMAIL_EXAMPLE_FROM=María García <maria@inmobiliaria.es>
EMAIL_EXAMPLE_USER=maria@inmobiliaria.es
# Gmail/Outlook with 2FA need an APP PASSWORD, not the account password.
EMAIL_EXAMPLE_PASSWORD=***

# Optional: Spanish residential/rotating proxy for the Lystos browser session.
# Datacenter IPs get reset by Lystos's CDN.
# PROXY_SERVER=http://user:pass@es-proxy-host:port

# Optional: explicit Chromium binary if the bundled one doesn't match.
# CHROMIUM_PATH=/usr/bin/chromium

# --- Only needed if an agent uses channel: whatsapp ---
# WA_VERIFY_TOKEN=change-me
# WA_EXAMPLE_PHONE_NUMBER_ID=123456789012345
# WA_EXAMPLE_ACCESS_TOKEN=EAAG...
