# ============================================================
#  Everything you need to fill in. No config files, no YAML.
# ============================================================

# Her Lystos login
LYSTOS_EMAIL=
LYSTOS_PASSWORD=

# Her name, as it should appear in the emails
AGENT_NAME=María García

# Her mailbox — drafts are written here
EMAIL_FROM=María García <maria@inmobiliaria.es>
EMAIL_USER=maria@inmobiliaria.es
# Gmail/Outlook with 2FA need an APP PASSWORD, not the login password.
EMAIL_PASSWORD=

# ---------- everything below is optional ----------

# Safety. true = nothing is contacted at all (default).
# false + EMAIL_MODE=draft = real drafts in her mailbox, still nothing sent.
DRY_RUN=true
# EMAIL_MODE=send        # flip to send emails directly, no drafts

# Mail provider (defaults are Gmail)
# SMTP_HOST=smtp.gmail.com
# IMAP_HOST=imap.gmail.com
# DRAFTS_MAILBOX=[Gmail]/Drafts

# Narrow the particulares feed further, if she wants
# ZONES=Gràcia,Eixample
# PRICE_MIN=100000
# PRICE_MAX=750000

# Override the Lystos page to watch (defaults to the particulares view)
# LYSTOS_SEARCH_URL=https://app.lystos.com/explora?anunciante=particular

# Spanish residential proxy, if Lystos blocks your IP
# PROXY_SERVER=http://user:pass@host:port
